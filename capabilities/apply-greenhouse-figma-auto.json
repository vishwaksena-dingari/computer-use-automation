{
  "schemaVersion": 1,
  "id": "apply-greenhouse-figma-auto",
  "version": "0.1.0",
  "surface": "web",
  "name": "Greenhouse Figma auto-bootstrap",
  "description": "Greenhouse job-board apply — hybrid bootstrap, no hand map, no submit.",
  "goalTemplate": "Fill Greenhouse application from profile",
  "template": "ats-apply-shell",
  "bindings": {
    "entryPath": "/figma/jobs/5813967004"
  },
  "inputs": [],
  "outputs": [],
  "businessOutcomes": [
    {
      "code": "field.UNMAPPED",
      "description": "Required form field missing or profile gap"
    },
    {
      "code": "field.VERIFY",
      "description": "Filled value did not stick on read-back"
    },
    {
      "code": "form.CAPTCHA",
      "description": "Captcha / bot wall — HITL with --escalate"
    },
    {
      "code": "form.CLOSED",
      "description": "Job/application no longer accepting"
    },
    {
      "code": "form.WIDGET",
      "description": "Unsupported or failing form widget"
    }
  ],
  "steps": [
    {
      "id": "s1",
      "action": "navigate",
      "urlFrom": "config.target.entryPath"
    },
    {
      "id": "s2",
      "action": "wait",
      "timeoutMs": 3000
    },
    {
      "id": "s3",
      "action": "fillForm",
      "fieldMapRef": "greenhouse-figma-auto"
    }
  ],
  "targets": {},
  "checkpoints": {
    "done": {
      "kind": "url",
      "includes": "greenhouse.io"
    },
    "success": {
      "kind": "allOf",
      "refs": [
        "done"
      ]
    }
  },
  "successCheckpoint": "success"
}
