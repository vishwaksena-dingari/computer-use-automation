{
  "schemaVersion": 1,
  "id": "apply-workday-shaped-auto",
  "version": "0.1.0",
  "surface": "web",
  "name": "Workday-shaped multi-page auto (local mock)",
  "description": "Local Workday-like login + Next pages via fillFormFlow; no hand map.",
  "goalTemplate": "Sign in and fill Workday-shaped multi-page apply",
  "template": "ats-apply-shell",
  "bindings": {
    "entryPath": "/apply-demo/workday-shaped/"
  },
  "inputs": [],
  "outputs": [],
  "businessOutcomes": [
    {
      "code": "field.UNMAPPED",
      "description": "Required form field missing or profile gap"
    },
    {
      "code": "field.VERIFY",
      "description": "Filled value did not stick on read-back"
    },
    {
      "code": "form.CAPTCHA",
      "description": "Captcha / bot wall — HITL with --escalate"
    },
    {
      "code": "form.CLOSED",
      "description": "Job/application no longer accepting"
    },
    {
      "code": "form.WIDGET",
      "description": "Unsupported or failing form widget"
    }
  ],
  "steps": [
    {
      "id": "s1",
      "action": "navigate",
      "urlFrom": "config.target.entryPath"
    },
    {
      "id": "s2",
      "action": "wait",
      "timeoutMs": 500
    },
    {
      "id": "s3",
      "action": "fillFormFlow",
      "fieldMapRef": "workday-shaped-auto",
      "maxPages": 5
    }
  ],
  "targets": {},
  "checkpoints": {
    "done": {
      "kind": "textIncludes",
      "text": "Application draft complete"
    },
    "success": {
      "kind": "allOf",
      "refs": [
        "done"
      ]
    }
  },
  "successCheckpoint": "success"
}
