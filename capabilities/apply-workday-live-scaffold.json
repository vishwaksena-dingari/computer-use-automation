{
  "schemaVersion": 1,
  "id": "apply-workday-live-scaffold",
  "version": "0.1.0",
  "surface": "web",
  "name": "Live Workday Apply → Sign In scaffold",
  "description": "Navigate job → Apply → Apply Manually → fill email/password via fillFormFlow. Does not create accounts; stop at auth or post-login pages. Set WORKDAY_EMAIL / WORKDAY_PASSWORD (or profile) for real Sign In.",
  "goalTemplate": "Reach Workday apply auth and fill sign-in",
  "template": "ats-apply-shell",
  "bindings": {},
  "inputs": [],
  "outputs": [],
  "businessOutcomes": [
    {
      "code": "field.UNMAPPED",
      "description": "Required form field missing or profile gap"
    },
    {
      "code": "field.VERIFY",
      "description": "Filled value did not stick on read-back"
    },
    {
      "code": "form.CAPTCHA",
      "description": "Captcha / bot wall — HITL with --escalate"
    },
    {
      "code": "form.CLOSED",
      "description": "Job/application no longer accepting"
    },
    {
      "code": "form.WIDGET",
      "description": "Unsupported or failing form widget"
    }
  ],
  "steps": [
    {
      "id": "s1",
      "action": "navigate",
      "urlFrom": "config.target.entryPath"
    },
    {
      "id": "s2",
      "action": "wait",
      "timeoutMs": 2500
    },
    {
      "id": "s3",
      "action": "click",
      "target": {
        "$ref": "#/targets/apply"
      }
    },
    {
      "id": "s4",
      "action": "wait",
      "timeoutMs": 1500
    },
    {
      "id": "s5",
      "action": "click",
      "target": {
        "$ref": "#/targets/applyManually"
      }
    },
    {
      "id": "s6",
      "action": "wait",
      "timeoutMs": 4000
    },
    {
      "id": "s7",
      "action": "click",
      "target": {
        "$ref": "#/targets/signInWithEmail"
      }
    },
    {
      "id": "s8",
      "action": "wait",
      "timeoutMs": 2000
    },
    {
      "id": "s9",
      "action": "fillFormFlow",
      "fieldMapRef": "workday-live-scaffold",
      "maxPages": 2
    }
  ],
  "targets": {
    "apply": {
      "strict": false,
      "timeoutMs": 15000,
      "candidates": [
        {
          "kind": "role",
          "rank": 1,
          "role": "button",
          "name": "Apply",
          "exact": true
        },
        {
          "kind": "role",
          "rank": 2,
          "role": "link",
          "name": "Apply",
          "exact": true
        },
        {
          "kind": "text",
          "rank": 3,
          "text": "Apply",
          "exact": true
        }
      ]
    },
    "applyManually": {
      "strict": false,
      "timeoutMs": 15000,
      "candidates": [
        {
          "kind": "role",
          "rank": 1,
          "role": "button",
          "name": "Apply Manually",
          "exact": false
        },
        {
          "kind": "text",
          "rank": 2,
          "text": "Apply Manually",
          "exact": false
        },
        {
          "kind": "role",
          "rank": 3,
          "role": "link",
          "name": "Apply Manually",
          "exact": false
        }
      ]
    },
    "signInWithEmail": {
      "strict": false,
      "timeoutMs": 15000,
      "candidates": [
        {
          "kind": "css",
          "rank": 1,
          "selector": "[data-automation-id='SignInWithEmailButton']"
        },
        {
          "kind": "role",
          "rank": 2,
          "role": "button",
          "name": "Sign in with email",
          "exact": false
        },
        {
          "kind": "text",
          "rank": 3,
          "text": "Sign in with email",
          "exact": false
        }
      ]
    }
  },
  "checkpoints": {
    "authGate": {
      "kind": "textIncludes",
      "text": "Sign In"
    },
    "createAccount": {
      "kind": "textIncludes",
      "text": "Create Account"
    },
    "emailField": {
      "kind": "textIncludes",
      "text": "Email"
    },
    "myInfo": {
      "kind": "textIncludes",
      "text": "My Information"
    },
    "success": {
      "kind": "anyOf",
      "refs": [
        "emailField",
        "createAccount",
        "myInfo",
        "authGate"
      ]
    }
  },
  "successCheckpoint": "success"
}
