{
  "schemaVersion": 1,
  "id": "apply-ashby-sciemo-auto",
  "version": "0.1.0",
  "surface": "web",
  "name": "Ashby Sciemo auto-bootstrap (no hand map)",
  "description": "Prove hybrid bootstrap authors the field-map without a committed map file.",
  "goalTemplate": "Open Sciemo application and fill from profile via auto field-map",
  "template": "ats-apply-shell",
  "bindings": {
    "entryPath": "/Sciemo/208da924-4a08-4be7-a20c-a420f08e77d2/application"
  },
  "inputs": [],
  "outputs": [],
  "businessOutcomes": [
    {
      "code": "field.UNMAPPED",
      "description": "Required form field missing or profile gap"
    },
    {
      "code": "field.VERIFY",
      "description": "Filled value did not stick on read-back"
    },
    {
      "code": "form.CAPTCHA",
      "description": "Captcha / bot wall — HITL with --escalate"
    },
    {
      "code": "form.CLOSED",
      "description": "Job/application no longer accepting"
    },
    {
      "code": "form.WIDGET",
      "description": "Unsupported or failing form widget"
    }
  ],
  "steps": [
    {
      "id": "s1",
      "action": "navigate",
      "urlFrom": "config.target.entryPath"
    },
    {
      "id": "s2",
      "action": "wait",
      "timeoutMs": 3000
    },
    {
      "id": "s3",
      "action": "fillForm",
      "fieldMapRef": "ashby-sciemo-auto"
    }
  ],
  "targets": {},
  "checkpoints": {
    "done": {
      "kind": "url",
      "includes": "application"
    },
    "success": {
      "kind": "allOf",
      "refs": [
        "done"
      ]
    }
  },
  "successCheckpoint": "success"
}
