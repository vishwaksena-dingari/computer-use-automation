{
  "schemaVersion": 1,
  "id": "apply-workday-live-create",
  "version": "0.1.0",
  "surface": "web",
  "name": "Live Workday Create Account → fill apply pages",
  "description": "Apply → Apply Manually → Sign in with email → Create Account → fill credentials → Sign In / Next through application pages. Stops before Submit Application. Requires profile email/password (or WORKDAY_* env).",
  "goalTemplate": "Create Workday account and fill application pages",
  "template": "ats-apply-shell",
  "bindings": {},
  "inputs": [],
  "outputs": [],
  "businessOutcomes": [
    {
      "code": "field.UNMAPPED",
      "description": "Required form field missing or profile gap"
    },
    {
      "code": "field.VERIFY",
      "description": "Filled value did not stick on read-back"
    },
    {
      "code": "form.CAPTCHA",
      "description": "Captcha / bot wall — HITL with --escalate"
    },
    {
      "code": "form.CLOSED",
      "description": "Job/application no longer accepting"
    },
    {
      "code": "form.WIDGET",
      "description": "Unsupported or failing form widget"
    }
  ],
  "steps": [
    {
      "id": "s1",
      "action": "navigate",
      "urlFrom": "config.target.entryPath"
    },
    {
      "id": "s2",
      "action": "wait",
      "timeoutMs": 3000
    },
    {
      "id": "s3",
      "action": "click",
      "target": {
        "$ref": "#/targets/apply"
      }
    },
    {
      "id": "s4",
      "action": "wait",
      "timeoutMs": 2000
    },
    {
      "id": "s5",
      "action": "click",
      "target": {
        "$ref": "#/targets/applyManually"
      }
    },
    {
      "id": "s6",
      "action": "wait",
      "timeoutMs": 4500
    },
    {
      "id": "s7",
      "action": "click",
      "target": {
        "$ref": "#/targets/signInWithEmail"
      }
    },
    {
      "id": "s8",
      "action": "wait",
      "timeoutMs": 2000
    },
    {
      "id": "s9",
      "action": "click",
      "target": {
        "$ref": "#/targets/createAccountLink"
      }
    },
    {
      "id": "s10",
      "action": "wait",
      "timeoutMs": 2500
    },
    {
      "id": "s11",
      "action": "fillFormFlow",
      "fieldMapRef": "workday-live-create",
      "maxPages": 10
    }
  ],
  "targets": {
    "apply": {
      "strict": false,
      "timeoutMs": 15000,
      "candidates": [
        {
          "kind": "role",
          "rank": 1,
          "role": "button",
          "name": "Apply",
          "exact": true
        },
        {
          "kind": "role",
          "rank": 2,
          "role": "link",
          "name": "Apply",
          "exact": true
        },
        {
          "kind": "text",
          "rank": 3,
          "text": "Apply",
          "exact": true
        }
      ]
    },
    "applyManually": {
      "strict": false,
      "timeoutMs": 15000,
      "candidates": [
        {
          "kind": "role",
          "rank": 1,
          "role": "button",
          "name": "Apply Manually",
          "exact": false
        },
        {
          "kind": "text",
          "rank": 2,
          "text": "Apply Manually",
          "exact": false
        },
        {
          "kind": "role",
          "rank": 3,
          "role": "link",
          "name": "Apply Manually",
          "exact": false
        }
      ]
    },
    "signInWithEmail": {
      "strict": false,
      "timeoutMs": 15000,
      "candidates": [
        {
          "kind": "css",
          "rank": 1,
          "selector": "[data-automation-id='SignInWithEmailButton']"
        },
        {
          "kind": "role",
          "rank": 2,
          "role": "button",
          "name": "Sign in with email",
          "exact": false
        },
        {
          "kind": "text",
          "rank": 3,
          "text": "Sign in with email",
          "exact": false
        }
      ]
    },
    "createAccountLink": {
      "strict": false,
      "timeoutMs": 15000,
      "candidates": [
        {
          "kind": "css",
          "rank": 1,
          "selector": "[data-automation-id='createAccountLink']"
        },
        {
          "kind": "role",
          "rank": 2,
          "role": "button",
          "name": "Create Account",
          "exact": true
        },
        {
          "kind": "role",
          "rank": 3,
          "role": "link",
          "name": "Create Account",
          "exact": false
        },
        {
          "kind": "text",
          "rank": 4,
          "text": "Create Account",
          "exact": true
        }
      ]
    }
  },
  "checkpoints": {
    "myInfo": {
      "kind": "textIncludes",
      "text": "My Information"
    },
    "experience": {
      "kind": "textIncludes",
      "text": "My Experience"
    },
    "review": {
      "kind": "textIncludes",
      "text": "Review"
    },
    "createAccount": {
      "kind": "textIncludes",
      "text": "Create Account"
    },
    "emailField": {
      "kind": "textIncludes",
      "text": "Email"
    },
    "success": {
      "kind": "anyOf",
      "refs": [
        "myInfo",
        "experience",
        "review",
        "createAccount",
        "emailField"
      ]
    }
  },
  "successCheckpoint": "success"
}
